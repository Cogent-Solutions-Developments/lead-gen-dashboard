# Core backend connection (required). This URL is embedded in browser assets.
NEXT_PUBLIC_API_BASE_URL=
# Server-only credential for authenticated KPI aggregation. Never prefix secrets with NEXT_PUBLIC_.
BACKEND_SERVICE_API_KEY=

# Optional Supabase browser client. The anonymous key is browser-visible by design;
# enforce all data access with Supabase Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only integrations
TEAMS_DEAL_BELL_WEBHOOK_URL=

# Browser-visible integrations
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_FEEDBACK_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_MEETING_TEMPLATE_ID=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Public Autocall URL, read on the server at runtime. No secrets here.
AUTOCALL_PUBLIC_URL=https://your-host.example/autocall-db

# Local HTTP loopback SSO works only with next dev. Do not override NODE_ENV here.
# See docs/autocall-integration.md for matching local URLs and ports.
